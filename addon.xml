<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.strmexporter" name="STRM Exporter" version="1.0.0" provider-name="madsession">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="addon.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" start="startup"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">STRM Exporter</summary>
        <description lang="en_GB">Browse video add-ons and export links as .strm files to Movies or TV Shows folders.</description>
        <assets>
            <icon>icon.png</icon>
        </assets>
        <platform>all</platform>
    </extension>
</addon>